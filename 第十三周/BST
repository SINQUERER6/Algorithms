"""
BST 可视化程序
功能：构建 BST，插入序列 [50,30,70,20,40,60,80]，画出原树，
      然后删除根结点 50，分别用"中序前驱"和"中序后继"策略，画出结果。
"""

import matplotlib.pyplot as plt
import matplotlib.patches as patches


# ==================== BST 数据结构 ====================

class BSTNode:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None


class BST:
    def __init__(self):
        self.root = None

    def insert(self, key):
        """插入结点"""
        if self.root is None:
            self.root = BSTNode(key)
        else:
            self._insert(self.root, key)

    def _insert(self, node, key):
        if key < node.key:
            if node.left is None:
                node.left = BSTNode(key)
            else:
                self._insert(node.left, key)
        else:
            if node.right is None:
                node.right = BSTNode(key)
            else:
                self._insert(node.right, key)

    def find_inorder_predecessor(self, node):
        """找中序前驱：左子树中最右的结点"""
        if node.left is None:
            return None
        current = node.left
        while current.right:
            current = current.right
        return current

    def find_inorder_successor(self, node):
        """找中序后继：右子树中最左的结点"""
        if node.right is None:
            return None
        current = node.right
        while current.left:
            current = current.left
        return current

    def delete(self, key, strategy='predecessor'):
        """删除指定结点，strategy 可选 'predecessor' 或 'successor'"""
        self.root = self._delete(self.root, key, strategy)

    def _delete(self, node, key, strategy):
        if node is None:
            return None

        if key < node.key:
            node.left = self._delete(node.left, key, strategy)
        elif key > node.key:
            node.right = self._delete(node.right, key, strategy)
        else:
            # 找到要删除的结点
            # 情况1：叶子结点
            if node.left is None and node.right is None:
                return None
            # 情况2：只有一个子结点
            elif node.left is None:
                return node.right
            elif node.right is None:
                return node.left
            # 情况3：有两个子结点
            else:
                if strategy == 'predecessor':
                    pred = self.find_inorder_predecessor(node)
                    node.key = pred.key
                    node.left = self._delete(node.left, pred.key, strategy)
                else:  # successor
                    succ = self.find_inorder_successor(node)
                    node.key = succ.key
                    node.right = self._delete(node.right, succ.key, strategy)
        return node


# ==================== 树的可视化 ====================

def get_tree_layout(node, x=0, y=0, level=0, pos_dict=None, parent_pos=None, edges=None):
    """递归计算每个结点的坐标位置和边"""
    if pos_dict is None:
        pos_dict = {}
    if edges is None:
        edges = []

    if node is None:
        return pos_dict, edges

    # 层数越深，水平间距越小
    offset = 3.0 / (level + 1)

    pos_dict[node.key] = (x, y)
    if parent_pos is not None:
        edges.append((parent_pos, (x, y)))

    if node.left:
        get_tree_layout(node.left, x - offset, y - 1, level + 1, pos_dict, (x, y), edges)
    if node.right:
        get_tree_layout(node.right, x + offset, y - 1, level + 1, pos_dict, (x, y), edges)

    return pos_dict, edges


def draw_tree(ax, root, title, highlight_key=None):
    """在指定的 axes 上绘制 BST"""
    if root is None:
        ax.set_title(title)
        ax.axis('off')
        return

    pos_dict, edges = get_tree_layout(root)

    # 画边
    for (x1, y1), (x2, y2) in edges:
        ax.plot([x1, x2], [y1, y2], 'k-', linewidth=1.5)

    # 画结点
    for key, (x, y) in pos_dict.items():
        if key == highlight_key:
            # 高亮显示（红色）
            circle = patches.Circle((x, y), 0.3, facecolor='lightcoral', edgecolor='red', linewidth=2)
        else:
            # 普通结点（蓝色）
            circle = patches.Circle((x, y), 0.3, facecolor='lightblue', edgecolor='blue', linewidth=1.5)
        ax.add_patch(circle)
        ax.text(x, y, str(key), ha='center', va='center', fontsize=12, fontweight='bold')

    ax.set_title(title, fontsize=14, fontweight='bold')
    ax.set_xlim(-5, 5)
    ax.set_ylim(-4, 1)
    ax.set_aspect('equal')
    ax.axis('off')


def copy_tree(node):
    """深拷贝一棵 BST"""
    if node is None:
        return None
    new_node = BSTNode(node.key)
    new_node.left = copy_tree(node.left)
    new_node.right = copy_tree(node.right)
    return new_node


def inorder_traversal(node, result=None):
    """中序遍历，返回列表"""
    if result is None:
        result = []
    if node:
        inorder_traversal(node.left, result)
        result.append(node.key)
        inorder_traversal(node.right, result)
    return result


# ==================== 主程序 ====================

def main():
    # 1. 构建原始 BST
    original_tree = BST()
    keys = [50, 30, 70, 20, 40, 60, 80]
    for k in keys:
        original_tree.insert(k)

    # 2. 复制两棵树，分别用两种策略删除 50
    tree_pred = BST()
    tree_pred.root = copy_tree(original_tree.root)
    tree_pred.delete(50, strategy='predecessor')

    tree_succ = BST()
    tree_succ.root = copy_tree(original_tree.root)
    tree_succ.delete(50, strategy='successor')

    # 3. 绘制三棵树
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))

    draw_tree(axes[0], original_tree.root, "Original BST\n[50,30,70,20,40,60,80]", highlight_key=50)
    draw_tree(axes[1], tree_pred.root, "After Delete 50\n(Inorder Predecessor: 40)", highlight_key=40)
    draw_tree(axes[2], tree_succ.root, "After Delete 50\n(Inorder Successor: 60)", highlight_key=60)

    plt.tight_layout()
    
    # 保存图片（可选）
    plt.savefig('bst_delete_comparison.png', dpi=150, bbox_inches='tight')
    print("图片已保存为 bst_delete_comparison.png")
    
    # 显示图片
    plt.show()

    # 4. 打印中序遍历结果
    print("Original BST inorder:", inorder_traversal(original_tree.root))
    print("After predecessor :", inorder_traversal(tree_pred.root))
    print("After successor  :", inorder_traversal(tree_succ.root))


if __name__ == "__main__":
    main()