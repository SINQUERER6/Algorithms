if __name__ == "__main__":
    # 示例1: 包含 None 的数组
    arr1 = [10,5,15,3,7,None,20]

    print("示例1:")
    print(f"输入数组: {arr1}")
    print("-" * 50)

    root1 = array_to_tree(arr1)
    print("树的形态:")
    print_tree(root1)

    print("\n" + "=" * 50)