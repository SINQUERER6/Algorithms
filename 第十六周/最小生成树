"""
最小生成树 (MST) - Prim算法和Kruskal算法实现
===============================================
给定6个顶点的无向带权图，用Prim和Kruskal法求MST
"""

import matplotlib.pyplot as plt
import networkx as nx


# ============================================================
# 1. 定义图的边和权重
# ============================================================
# 顶点: A, B, C, D, E, F
# 边列表: (起点, 终点, 权重)
edges = [
    ('A', 'B', 2),   # A-B 权重2
    ('A', 'D', 3),   # A-D 权重3
    ('B', 'C', 4),   # B-C 权重4
    ('B', 'E', 1),   # B-E 权重1
    ('C', 'F', 5),   # C-F 权重5
    ('D', 'E', 6),   # D-E 权重6
    ('E', 'F', 2),   # E-F 权重2
]

# 创建NetworkX图对象
G = nx.Graph()
for u, v, w in edges:
    G.add_edge(u, v, weight=w)


# ============================================================
# 2. Prim算法实现
# ============================================================
def prim_mst(graph, start):
    """
    Prim算法求最小生成树

    思路：从起始顶点开始，逐步扩展已访问集合，
          每次选择连接已访问顶点和未访问顶点的最小权重边

    参数:
        graph: NetworkX图对象
        start: 起始顶点

    返回:
        mst_edges: MST的边列表 [(u, v, weight), ...]
        total_weight: MST总权重
        steps: 执行步骤记录
    """
    mst_edges = []          # 存储MST的边
    visited = set([start])  # 已访问顶点集合
    total_weight = 0        # 总权重
    steps = []              # 记录每一步

    # 当已访问顶点数 < 总顶点数时，继续选择边
    while len(visited) < len(graph.nodes):
        min_edge = None
        min_weight = float('inf')

        # 遍历所有已访问顶点的邻接边
        for u in visited:
            for v in graph.neighbors(u):
                # 只考虑连接未访问顶点的边
                if v not in visited:
                    weight = graph[u][v]['weight']
                    # 找最小权重边
                    if weight < min_weight:
                        min_weight = weight
                        min_edge = (u, v, weight)

        # 将最小边加入MST
        if min_edge:
            u, v, w = min_edge
            mst_edges.append(min_edge)
            visited.add(v)
            total_weight += w
            steps.append(f"选择边 ({u}-{v}), 权重={w}, 已访问顶点: {sorted(visited)}")

    return mst_edges, total_weight, steps


# ============================================================
# 3. Kruskal算法实现
# ============================================================
def find(parent, i):
    """
    并查集：查找根节点（带路径压缩）
    """
    if parent[i] != i:
        parent[i] = find(parent, parent[i])
    return parent[i]


def union(parent, rank, x, y):
    """
    并查集：合并两个集合（按秩合并）
    """
    root_x = find(parent, x)
    root_y = find(parent, y)

    if rank[root_x] < rank[root_y]:
        parent[root_x] = root_y
    elif rank[root_x] > rank[root_y]:
        parent[root_y] = root_x
    else:
        parent[root_y] = root_x
        rank[root_x] += 1


def kruskal_mst(graph):
    """
    Kruskal算法求最小生成树

    思路：按权重从小到大排序所有边，用并查集判断是否形成环，
          不形成环则加入MST

    参数:
        graph: NetworkX图对象

    返回:
        mst_edges: MST的边列表 [(u, v, weight), ...]
        total_weight: MST总权重
        steps: 执行步骤记录
    """
    # 获取所有边并按权重升序排序
    all_edges = []
    for u, v, data in graph.edges(data=True):
        all_edges.append((data['weight'], u, v))
    all_edges.sort()  # 按权重排序

    # 初始化并查集
    nodes = sorted(graph.nodes())
    parent = {node: node for node in nodes}  # 每个节点的父节点初始化为自己
    rank = {node: 0 for node in nodes}        # 秩（树的高度）

    mst_edges = []
    total_weight = 0
    steps = []

    # 遍历排序后的边
    for weight, u, v in all_edges:
        # 检查u和v是否在同一个集合（即是否形成环）
        if find(parent, u) != find(parent, v):
            # 不形成环，加入MST
            union(parent, rank, u, v)
            mst_edges.append((u, v, weight))
            total_weight += weight
            steps.append(f"选择边 ({u}-{v}), 权重={weight}")
        else:
            # 形成环，跳过
            steps.append(f"跳过边 ({u}-{v}), 权重={weight} — 会形成环")

        # MST有 n-1 条边时结束
        if len(mst_edges) == len(graph.nodes()) - 1:
            break

    return mst_edges, total_weight, steps


# ============================================================
# 4. 运行算法并输出结果
# ============================================================
if __name__ == "__main__":

    print("=" * 60)
    print("最小生成树 (MST) - Prim算法和Kruskal算法")
    print("=" * 60)

    # 打印原始图的边列表
    print("\n原始图的边列表（按权重排序）：")
    print("-" * 60)
    for u, v, w in sorted(edges, key=lambda x: x[2]):
        print(f"  {u} -- {v} : 权重 = {w}")

    # ---------- Prim算法 ----------
    print("\n" + "=" * 60)
    print("【Prim算法】从顶点 A 开始")
    print("=" * 60)
    prim_edges, prim_weight, prim_steps = prim_mst(G, 'A')
    for step in prim_steps:
        print(f"  → {step}")
    print(f"\n  Prim MST 总权重: {prim_weight}")
    print(f"  Prim MST 边: {[(u,v,w) for u,v,w in prim_edges]}")

    # ---------- Kruskal算法 ----------
    print("\n" + "=" * 60)
    print("【Kruskal算法】")
    print("=" * 60)
    kruskal_edges, kruskal_weight, kruskal_steps = kruskal_mst(G)
    for step in kruskal_steps:
        print(f"  → {step}")
    print(f"\n  Kruskal MST 总权重: {kruskal_weight}")
    print(f"  Kruskal MST 边: {[(u,v,w) for u,v,w in kruskal_edges]}")

    # 验证结果
    print("\n" + "=" * 60)
    print(f"验证：两种算法得到的MST总权重相同 = {prim_weight == kruskal_weight}")
    print("=" * 60)

    # ---------- 可视化 ----------
    print("\n正在生成可视化图表...")

    # MST的边集合（用于判断）
    mst_edges_set = set()
    for u, v, w in prim_edges:
        mst_edges_set.add((u, v))
        mst_edges_set.add((v, u))

    # 设置节点位置（与原图对应）
    pos = {
        'A': (0, 1),
        'B': (1, 1),
        'C': (2, 1),
        'D': (0, 0),
        'E': (1, 0),
        'F': (2, 0),
    }

    fig, axes = plt.subplots(1, 3, figsize=(18, 6))

    # --- 图1: 原始图 ---
    ax1 = axes[0]
    ax1.set_title('原始无向带权图', fontsize=14, fontweight='bold')

    for u, v, w in edges:
        x1, y1 = pos[u]
        x2, y2 = pos[v]
        ax1.plot([x1, x2], [y1, y2], 'gray', linewidth=2, zorder=1)
        mx, my = (x1+x2)/2, (y1+y2)/2
        ax1.text(mx, my, str(w), fontsize=12, fontweight='bold', color='orange',
                 ha='center', va='center',
                 bbox=dict(boxstyle='round,pad=0.2', facecolor='white', edgecolor='none', alpha=0.8))

    for node, (x, y) in pos.items():
        circle = plt.Circle((x, y), 0.15, color='#4a90d9', ec='#2c5aa0', linewidth=2, zorder=2)
        ax1.add_patch(circle)
        ax1.text(x, y, node, fontsize=14, fontweight='bold', color='white', ha='center', va='center', zorder=3)

    ax1.set_xlim(-0.5, 2.5)
    ax1.set_ylim(-0.5, 1.5)
    ax1.set_aspect('equal')
    ax1.axis('off')

    # --- 图2: Prim算法结果 ---
    ax2 = axes[1]
    ax2.set_title(f'Prim算法 MST (总权重={prim_weight})', fontsize=14, fontweight='bold')

    non_mst = set()
    for u, v, w in edges:
        if (u, v) not in mst_edges_set:
            non_mst.add((u, v, w))

    for u, v, w in non_mst:
        x1, y1 = pos[u]
        x2, y2 = pos[v]
        ax2.plot([x1, x2], [y1, y2], 'gray', linewidth=1.5, linestyle='--', alpha=0.5, zorder=1)
        mx, my = (x1+x2)/2, (y1+y2)/2
        ax2.text(mx, my, str(w), fontsize=10, color='gray', ha='center', va='center', alpha=0.6)

    prim_order = [('A', 'B', 2), ('B', 'E', 1), ('E', 'F', 2), ('A', 'D', 3), ('B', 'C', 4)]
    for i, (u, v, w) in enumerate(prim_order):
        x1, y1 = pos[u]
        x2, y2 = pos[v]
        ax2.plot([x1, x2], [y1, y2], '#e74c3c', linewidth=4, zorder=1)
        mx, my = (x1+x2)/2, (y1+y2)/2
        offset = 0.08
        if u == 'A' and v == 'B':
            label_x, label_y = mx, my + offset
        elif u == 'B' and v == 'E':
            label_x, label_y = mx + offset, my
        elif u == 'E' and v == 'F':
            label_x, label_y = mx, my - offset
        elif u == 'A' and v == 'D':
            label_x, label_y = mx - offset, my
        else:
            label_x, label_y = mx, my + offset

        ax2.text(label_x, label_y, f'{w} (#{i+1})', fontsize=11, fontweight='bold', color='#c0392b',
                 ha='center', va='center',
                 bbox=dict(boxstyle='round,pad=0.15', facecolor='#ffeaa7', edgecolor='#e74c3c', alpha=0.9))

    for node, (x, y) in pos.items():
        circle = plt.Circle((x, y), 0.15, color='#4a90d9', ec='#2c5aa0', linewidth=2, zorder=2)
        ax2.add_patch(circle)
        ax2.text(x, y, node, fontsize=14, fontweight='bold', color='white', ha='center', va='center', zorder=3)

    ax2.set_xlim(-0.5, 2.5)
    ax2.set_ylim(-0.5, 1.5)
    ax2.set_aspect('equal')
    ax2.axis('off')

    # --- 图3: Kruskal算法结果 ---
    ax3 = axes[2]
    ax3.set_title(f'Kruskal算法 MST (总权重={kruskal_weight})', fontsize=14, fontweight='bold')

    for u, v, w in non_mst:
        x1, y1 = pos[u]
        x2, y2 = pos[v]
        ax3.plot([x1, x2], [y1, y2], 'gray', linewidth=1.5, linestyle='--', alpha=0.5, zorder=1)
        mx, my = (x1+x2)/2, (y1+y2)/2
        ax3.text(mx, my, str(w), fontsize=10, color='gray', ha='center', va='center', alpha=0.6)

    kruskal_order = [('B', 'E', 1), ('A', 'B', 2), ('E', 'F', 2), ('A', 'D', 3), ('B', 'C', 4)]
    for i, (u, v, w) in enumerate(kruskal_order):
        x1, y1 = pos[u]
        x2, y2 = pos[v]
        ax3.plot([x1, x2], [y1, y2], '#27ae60', linewidth=4, zorder=1)
        mx, my = (x1+x2)/2, (y1+y2)/2
        offset = 0.08
        if (u == 'B' and v == 'E') or (u == 'E' and v == 'B'):
            label_x, label_y = mx + offset, my
        elif (u == 'A' and v == 'B') or (u == 'B' and v == 'A'):
            label_x, label_y = mx, my + offset
        elif (u == 'E' and v == 'F') or (u == 'F' and v == 'E'):
            label_x, label_y = mx, my - offset
        elif (u == 'A' and v == 'D') or (u == 'D' and v == 'A'):
            label_x, label_y = mx - offset, my
        else:
            label_x, label_y = mx, my + offset

        ax3.text(label_x, label_y, f'{w} (#{i+1})', fontsize=11, fontweight='bold', color='#1e8449',
                 ha='center', va='center',
                 bbox=dict(boxstyle='round,pad=0.15', facecolor='#a8e6cf', edgecolor='#27ae60', alpha=0.9))

    for node, (x, y) in pos.items():
        circle = plt.Circle((x, y), 0.15, color='#4a90d9', ec='#2c5aa0', linewidth=2, zorder=2)
        ax3.add_patch(circle)
        ax3.text(x, y, node, fontsize=14, fontweight='bold', color='white', ha='center', va='center', zorder=3)

    ax3.set_xlim(-0.5, 2.5)
    ax3.set_ylim(-0.5, 1.5)
    ax3.set_aspect('equal')
    ax3.axis('off')

    plt.tight_layout()
    plt.savefig('mst_result.png', dpi=150, bbox_inches='tight', facecolor='white')
    plt.show()
    print("\n图表已保存为 mst_result.png")